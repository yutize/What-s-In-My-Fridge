# Example environment variables for local development
# Copy to .env and fill values (do NOT commit .env to version control)
VITE_API_KEY="your_edamam_api_key_here"
VITE_APP_ID="your_edamam_app_id_here"

# If running server-side, set these in your environment (not in the client bundle)
# API_KEY and APP_ID should be set as repository secrets in CI
# API_KEY="your_edamam_api_key_here"
# APP_ID="your_edamam_app_id_here"
